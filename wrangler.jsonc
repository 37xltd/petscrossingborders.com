{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "petscrossingborders-com",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "petscrossingborders.com/*", "zone_name": "petscrossingborders.com" },
    { "pattern": "www.petscrossingborders.com/*", "zone_name": "petscrossingborders.com" }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
